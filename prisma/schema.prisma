generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MULTI-TENANCY, AUTH & RBAC
// ==========================================

enum RoleCode {
  SUPER_ADMIN
  ORG_ADMIN
  SALES_MANAGER
  SALES_REP
  MARKETING
  HR_MANAGER
  FINANCE_MANAGER
  PROJECT_MANAGER
  EMPLOYEE
  CLIENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  logoUrl     String?
  industry    String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships        Membership[]
  roles              Role[]
  departments        Department[]
  employees          Employee[]
  attendanceRecords  Attendance[]
  leaveRequests      LeaveRequest[]
  workLogs           WorkLog[]
  leadSources        LeadSource[]
  leads              Lead[]
  tags               Tag[]
  companies          Company[]
  contacts           Contact[]
  pipelines          Pipeline[]
  deals              Deal[]
  activities         Activity[]
  tasks              Task[]
  meetings           Meeting[]
  projects           Project[]
  jobListings        JobListing[]
  jobApplications    JobApplication[]
  invoices           Invoice[]
  expenses           Expense[]
  services           Service[]
  portfolioProjects  PortfolioProject[]
  testimonials       Testimonial[]
  faqs               Faq[]
  pages              Page[]
  blogCategories     BlogCategory[]
  blogTags           BlogTag[]
  blogPosts          BlogPost[]
  mediaFiles         Media[]
  contactSubmissions ContactSubmission[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  siteSettings       SiteSetting[]
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  avatarUrl         String?
  phone             String?
  emailVerified     DateTime?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  memberships             Membership[]
  employeeProfile         Employee?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedLeads              Lead[]                   @relation("LeadOwner")
  ownedContacts           Contact[]                @relation("ContactOwner")
  ownedDeals              Deal[]                   @relation("DealOwner")
  activities              Activity[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  taskComments            TaskComment[]
  organizedMeetings       Meeting[]                @relation("MeetingOrganizer")
  projectMemberships      ProjectMember[]
  authoredPosts           BlogPost[]
  uploadedMedia           Media[]
  notifications           Notification[]
  auditLogs               AuditLog[]
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  code           RoleCode
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// HR & EMPLOYEE MANAGEMENT
// ==========================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  REMOTE
  HALF_DAY
  ABSENT
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
}

model Employee {
  id              String         @id @default(cuid())
  organizationId  String
  userId          String?        @unique
  departmentId    String?
  employeeCode    String
  fullName        String
  slug            String
  email           String
  phone           String?
  designation     String
  bio             String?
  avatarUrl       String?
  skills          String[]       @default([])
  experienceYears Int            @default(0)
  salary          Decimal?       @db.Decimal(12, 2)
  joinDate        DateTime       @default(now())
  status          EmployeeStatus @default(ACTIVE)
  isPublicProfile Boolean        @default(false)
  displayOrder    Int            @default(0)
  socialLinks     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendance   Attendance[]
  leaves       LeaveRequest[]
  workLogs     WorkLog[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, slug])
  @@index([organizationId, isPublicProfile])
}

model Attendance {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

model LeaveRequest {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  leaveType      String
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         LeaveStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model WorkLog {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  projectId      String?
  date           DateTime @db.Date
  hours          Decimal  @db.Decimal(5, 2)
  description    String
  billable       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
}

// ==========================================
// CRM: LEADS, CONTACTS, COMPANIES, DEALS
// ==========================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  CONVERTED
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, name])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#3b82f6")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTag[]
  contacts     ContactTag[]

  @@unique([organizationId, name])
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  website        String?
  industry       String?
  size           String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  projects     Project[]
  invoices     Invoice[]
  activities   Activity[]

  @@index([organizationId, deletedAt])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  ownerId        String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  jobTitle       String?
  avatarUrl      String?
  notes          String?
  isClient       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags         ContactTag[]
  deals        Deal[]
  activities   Activity[]
  invoices     Invoice[]
  projects     Project[]

  @@index([organizationId, email])
  @@index([organizationId, deletedAt])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Lead {
  id                 String     @id @default(cuid())
  organizationId     String
  sourceId           String?
  ownerId            String?
  name               String
  email              String
  phone              String?
  companyName        String?
  serviceInterest    String?
  score              Int        @default(50)
  estimatedValue     Decimal?   @db.Decimal(12, 2)
  status             LeadStatus @default(NEW)
  followUpDate       DateTime?
  notes              String?
  convertedAt        DateTime?
  convertedContactId String?
  convertedCompanyId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source            LeadSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  owner             User?               @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tags              LeadTag[]
  deals             Deal[]
  activities        Activity[]
  tasks             Task[]
  meetings          Meeting[]
  contactSubmission ContactSubmission?

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, ownerId])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@unique([organizationId, name])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  color       String   @default("#3b82f6")
  probability Int      @default(20)
  position    Int
  isWonStage  Boolean  @default(false)
  isLostStage Boolean  @default(false)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id                String     @id @default(cuid())
  organizationId    String
  pipelineId        String
  stageId           String
  ownerId           String?
  leadId            String?
  contactId         String?
  companyId         String?
  title             String
  amount            Decimal    @db.Decimal(14, 2)
  probability       Int        @default(20)
  expectedCloseDate DateTime?
  status            DealStatus @default(OPEN)
  description       String?
  closedAt          DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id])
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  owner        User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  history      DealHistory[]
  activities   Activity[]
  tasks        Task[]
  meetings     Meeting[]

  @@index([organizationId, stageId, deletedAt])
  @@index([organizationId, status])
}

model DealHistory {
  id          String   @id @default(cuid())
  dealId      String
  fromStage   String?
  toStage     String
  changedBy   String?
  note        String?
  createdAt   DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Activity {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?
  leadId         String?
  contactId      String?
  companyId      String?
  dealId         String?
  type           ActivityType
  status         ActivityStatus @default(COMPLETED)
  subject        String
  description    String?
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduledAt])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  assigneeId     String?
  creatorId      String?
  leadId         String?
  dealId         String?
  projectId      String?
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments     TaskComment[]

  @@index([organizationId, status, dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meeting {
  id             String   @id @default(cuid())
  organizationId String
  organizerId    String?
  leadId         String?
  dealId         String?
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  location       String?
  meetingUrl     String?
  participants   String[] @default([])
  reminderAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizer    User?        @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId, startTime])
}

// ==========================================
// PROJECT MANAGEMENT
// ==========================================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String?
  name           String
  code           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  progress       Int           @default(0)
  budget         Decimal?      @db.Decimal(14, 2)
  startDate      DateTime?
  deadline       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  workLogs     WorkLog[]
  invoices     Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("Member")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ==========================================
// RECRUITMENT
// ==========================================

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model JobListing {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  slug           String
  department     String
  location       String
  employmentType String        @default("Full-Time")
  salaryRange    String?
  description    String
  requirements   String[]      @default([])
  benefits       String[]      @default([])
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model JobApplication {
  id             String            @id @default(cuid())
  organizationId String
  jobListingId   String
  applicantName  String
  email          String
  phone          String?
  portfolioUrl   String?
  resumeUrl      String?
  coverLetter    String?
  status         ApplicationStatus @default(APPLIED)
  interviewDate  DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobListing   JobListing   @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ==========================================
// FINANCE: INVOICES, PAYMENTS, EXPENSES
// ==========================================

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  companyId      String?
  contactId      String?
  projectId      String?
  invoiceNumber  String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(14, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  method    String   @default("Bank Transfer")
  reference String?
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  category       String
  amount         Decimal  @db.Decimal(14, 2)
  expenseDate    DateTime @default(now())
  vendor         String?
  receiptUrl     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expenseDate])
}

// ==========================================
// CMS, BLOG, PORTFOLIO, MEDIA & PUBLIC SITE
// ==========================================

model Service {
  id               String        @id @default(cuid())
  organizationId   String
  title            String
  slug             String
  category         String
  shortDescription String
  description      String
  featuredImage    String?
  iconName         String?
  benefits         String[]      @default([])
  processSteps     Json?
  faqs             Json?
  status           PublishStatus @default(DRAFT)
  displayOrder     Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model PortfolioProject {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  slug           String
  category       String
  clientName     String?
  industry       String?
  summary        String
  challenge      String?
  solution       String?
  results        String?
  technologies   String[]      @default([])
  featuredImage  String?
  galleryImages  String[]      @default([])
  liveUrl        String?
  isFeatured     Boolean       @default(false)
  status         PublishStatus @default(DRAFT)
  completedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Testimonial {
  id             String        @id @default(cuid())
  organizationId String
  authorName     String
  authorRole     String
  companyName    String?
  avatarUrl      String?
  quote          String
  rating         Int           @default(5)
  status         PublishStatus @default(PUBLISHED)
  displayOrder   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Faq {
  id             String        @id @default(cuid())
  organizationId String
  category       String
  question       String
  answer         String
  displayOrder   Int           @default(0)
  status         PublishStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Page {
  id             String        @id @default(cuid())
  organizationId String
  slug           String
  title          String
  status         PublishStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     PageSection[]

  @@unique([organizationId, slug])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  key       String
  title     String?
  subtitle  String?
  content   Json
  position  Int      @default(0)
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
}

model BlogCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        BlogPost[]

  @@unique([organizationId, slug])
}

model BlogTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        BlogPostTag[]

  @@unique([organizationId, slug])
}

model BlogPost {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  authorId       String?
  title          String
  slug           String
  excerpt        String
  content        String
  featuredImage  String?
  readingTime    Int           @default(4)
  isFeatured     Boolean       @default(false)
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags         BlogPostTag[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, publishedAt])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Media {
  id             String   @id @default(cuid())
  organizationId String
  uploadedById   String?
  filename       String
  originalName   String
  url            String
  mimeType       String
  sizeBytes      Int
  altText        String?
  folder         String   @default("general")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, folder])
}

model ContactSubmission {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?  @unique
  name           String
  email          String
  phone          String?
  subject        String
  service        String?
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model SiteSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// ==========================================
// NOTIFICATIONS & AUDIT LOGS
// ==========================================

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           String    @default("info")
  link           String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
